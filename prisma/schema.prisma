datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  goals         FinancialGoal[]
  healthScores  HealthScoreSnapshot[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  userId      String?  // null if system default category
  name        String
  type        String   @default("EXPENSE") // EXPENSE, INCOME, SAVINGS
  isEssential Boolean  @default(false)     // For Needs (50%) vs Wants (30%) calculation
  color       String   @default("#64748b")
  icon        String   @default("Tag")
  budgetLimit Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  keywords     CategoryKeyword[]

  @@index([userId])
}

model CategoryKeyword {
  id         String   @id @default(cuid())
  categoryId String
  keyword    String   // lowercased matching pattern
  priority   Int      @default(0)

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([keyword])
}

model Transaction {
  id            String    @id @default(cuid())
  userId        String
  categoryId    String?
  amount        Float
  type          String    @default("EXPENSE") // EXPENSE, INCOME, TRANSFER
  date          DateTime
  description   String    // Raw string from statement/input
  merchant      String?   // Cleaned/normalized entity name
  notes         String?
  source        String    @default("MANUAL")  // MANUAL, CSV_IMPORT, DEMO_SEED
  importBatchId String?
  isRecurring   Boolean   @default(false)
  reasoning     String?   // Categorization rule/keyword audit trail
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, type])
}

model Budget {
  id          String    @id @default(cuid())
  userId      String
  categoryId  String?   // null if global monthly expense budget
  period      String    @default("MONTHLY") // MONTHLY, WEEKLY
  amount      Float
  month       Int       // 1-12
  year        Int       // e.g. 2026
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, year, month])
}

model FinancialGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  categoryType  String    @default("EMERGENCY_FUND") // EMERGENCY_FUND, SAVINGS, DEBT_PAYOFF, RETIREMENT, CUSTOM
  status        String    @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HealthScoreSnapshot {
  id              String   @id @default(cuid())
  userId          String
  score           Int      // 0 - 100
  savingsRate     Float    // % savings out of income
  essentialRatio  Float    // % essential needs out of income
  discretionRatio Float    // % discretionary wants out of income
  bufferMonths    Float    // emergency buffer in months
  monthlyIncome   Float
  monthlyExpense  Float
  netSavings      Float
  insightsJson    String   // Computed plain-language insight cards JSON
  breakdownJson   String   // Detailed weighted score breakdown JSON
  calculatedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calculatedAt])
}
